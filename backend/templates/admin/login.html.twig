{% extends 'base.html.twig' %}

{% block title %}Admin Login{% endblock %}

{% block body %}
    <div style="max-width:420px;margin:64px auto;padding:24px;border:1px solid #ddd;border-radius:8px;font-family:Arial,sans-serif;">
        <h1 style="margin-top:0;font-size:24px;">Connexion admin</h1>

        {% if error %}
            <div style="padding:10px;background:#ffe8e8;border:1px solid #ffb3b3;color:#a10000;border-radius:6px;margin-bottom:14px;">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post">
            <div style="margin-bottom:12px;">
                <label for="username" style="display:block;margin-bottom:6px;">Email</label>
                <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus style="width:100%;padding:10px;border:1px solid #bbb;border-radius:6px;">
            </div>

            <div style="margin-bottom:12px;">
                <label for="password" style="display:block;margin-bottom:6px;">Mot de passe</label>
                <input type="password" id="password" name="_password" required style="width:100%;padding:10px;border:1px solid #bbb;border-radius:6px;">
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" style="padding:10px 14px;border:0;border-radius:6px;background:#222;color:#fff;cursor:pointer;">Se connecter</button>
        </form>
    </div>
{% endblock %}
